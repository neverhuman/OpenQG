<<<ZYAL v1:daemon id=zyal-genome-template>>>
version: v1
intent: daemon
confirm: RUN_FOREVER

job:
  name: zyal-genome-template
  objective: Define the reusable theory-gene evolution scaffold for OpenQG.
  risk: medium

loop:
  policy: forever
  sleep: 30m

context:
  repository_root: .
  stage_root: ZYAL/stages
  run_root: target/openqg/zyal-genome
  canonical_variants:
    - pure-jnoccio
    - hybrid
    - jailgun-only

workflow:
  stage_sequence:
    - 00-atlas
    - 01-decompose-known
    - 02-decompose-failed
    - 03-generate-genes
    - 04-repair-genes
    - 05-compatibility
    - 06-assemble-modules
    - 07-macro-test
    - 08-failure-slicing
    - 09-selection-mutation
    - 10-promotion

evaluation:
  schema_version: zyal-gene-eval.v1
  variant: template
  output_root: target/openqg/zyal-genome/template
  max_generations_default: 1
  score_blend:
    local_score: 0.30
    interface_score: 0.20
    macro_score: 0.30
    innovation_score: 0.15
    failure_penalty: 0.05
  routing:
    standard_backend: jnoccio
    hard_backend: jailgun
    hard_route_tier: top20_pct_only
    standard_route_tier: standard
  judge:
    family: jnoccio
    provenance: scripted-template
    token_budget:
      prompt: 4096
      completion: 2048
  evidence:
    run_events: run-events.jsonl
    stage_ledger: stage-ledger.jsonl
    run_summary: run-summary.json
    offline_eval: offline-eval.json
    comparison: comparison.json

budgets:
  max_generations: 1
  max_runtime_minutes: 5

models:
  primary: jnoccio
  fallback: jailgun

experiments:
  route_policy: top20_pct_only
  hard_stage_families:
    - hard
  soft_stage_families:
    - standard

stop:
  all:
    - shell:
        command: "test -f .halt-zyal-genome || test -s target/openqg/zyal-genome/template/latest/run-summary.json"
        timeout: 10s
        assert:
          exit_code: 0

checkpoint:
  when: after_verified_change

permissions:
  git_push: deny

ui:
  theme: jekko-gold
  banner: OpenQG ZYAL genome template
<<<END_ZYAL id=zyal-genome-template>>>
ZYAL_ARM RUN_FOREVER id=zyal-genome-template
