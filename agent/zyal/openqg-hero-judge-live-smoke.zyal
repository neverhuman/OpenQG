<<<ZYAL v1:daemon id=openqg-hero-judge-live-smoke>>>
version: v1
intent: daemon
confirm: RUN_FOREVER

job:
  name: openqg-hero-judge-live-smoke
  objective: Run a bounded live Hero/Judge proof that tracks improving universal physics theory, question, and rubric quality.
  risk:
    - Keep live model calls bounded.
    - Do not persist raw chain-of-thought or full provider payloads.

loop:
  policy: bounded
  sleep: 30m

stop:
  all:
    - shell:
        command: "test -f .halt-hero-judge-live-smoke || test -f target/openqg/hero-judge/openqg-hero-judge-live-smoke/complete.ok"
        timeout: 10s
        assert:
          exit_code: 0

checkpoint:
  when: after_verified_change

permissions:
  git_push: deny
  research: allow
  webfetch: ask

ui:
  theme: jekko-gold
  banner: OpenQG hero/judge live smoke
<<<END_ZYAL id=openqg-hero-judge-live-smoke>>>
ZYAL_ARM RUN_FOREVER id=openqg-hero-judge-live-smoke
