\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Evidence assigned to the same $h$--$\Omega _m$--$w_0$ drift direction under successive rubrics. Diagonal scoring awarded $+54.9$ nats; the true correlated distance-prior covariance \emph  {raised} it to $+68.8$ (the diagonal treatment had overstated the compressed CMB's constraining power); anchor-calibrating the engine's $\ell _A$ fitting formula and charging the Occam term closes the valley to $-20.5$ (diagonal) and $-31.9$ (covariance). The apparent discovery was an instrument artifact.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:valley}{{5}{7}{Evidence assigned to the same $h$--$\Omega _m$--$w_0$ drift direction under successive rubrics. Diagonal scoring awarded $+54.9$ nats; the true correlated distance-prior covariance \emph {raised} it to $+68.8$ (the diagonal treatment had overstated the compressed CMB's constraining power); anchor-calibrating the engine's $\lA $ fitting formula and charging the Occam term closes the valley to $-20.5$ (diagonal) and $-31.9$ (covariance). The apparent discovery was an instrument artifact}{figure.5}{}}
