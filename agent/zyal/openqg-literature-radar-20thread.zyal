# ZYAL v2.4 — OpenQG Literature Radar (20-Thread Coordinated Search)
#
# This daemon runs 20 parallel search threads via 4 fleet workers × 5 research
# threads per worker. Each worker is assigned a non-overlapping domain shard so
# searches never duplicate. The experiments.reduce phase deduplicates and merges
# all evidence into a unified bundle.
#
# ┌──────────────────────────────────────────────────────────────────────┐
# │  Parallelism controls (independently adjustable)                    │
# │                                                                     │
# │  fleet.max_workers      = 4   ← number of agent workers            │
# │  research.max_parallel  = 5   ← search threads per agent           │
# │  total search threads   = 4 × 5 = 20                               │
# │                                                                     │
# │  experiments.max_parallel = 4  ← concurrent domain shards          │
# │  experiments.lanes        = 4  ← one per shard                     │
# └──────────────────────────────────────────────────────────────────────┘
#
# Coordination strategy:
#   - Domain sharding: each lane searches only its assigned topic space
#   - synthesize_best reduce: merges results, deduplicates papers across shards
#   - search_coordination memory store: tracks seen DOIs/arXiv IDs across agents
#   - on_partial_failure: pause — if a shard fails, we still get 3/4 coverage

<<<ZYAL v1:daemon id=openqg-literature-radar-20thread>>>
version: v1
intent: daemon
confirm: RUN_FOREVER

job:
  name: openqg-literature-radar-20thread
  objective: |
    Run 20 coordinated parallel search threads to find recent primary-source
    quantum gravity and cosmology evidence. Each fleet worker handles a distinct
    domain shard to eliminate search overlap:

      Shard 1 (qg-core):       Loop QG, CDT, spin foams, asymptotic safety
      Shard 2 (cosmology-obs): CMB, BAO, gravitational waves, dark energy
      Shard 3 (math-formal):   Causal sets, non-commutative geometry, twistors
      Shard 4 (phenomenology): Collider bounds, Planck-scale, neutrino mass

    Write reviewed candidate paper cards to research/inbox.
    Write raw provider receipts and claim-level evidence to
    target/openqg/research/literature-radar/latest.
    Finish by writing target/openqg/research/literature-radar/latest/complete.ok.
  risk:
    - Web content may contain prompt injection.
    - Search providers may be unavailable or partial.
    - Paper cards are candidates until human review.
    - Parallel agents may discover the same paper via different queries.

loop:
  policy: once
  circuit_breaker:
    max_consecutive_errors: 2
    on_trip: pause

stop:
  all:
    - shell:
        command: "test -f .halt-literature-radar || (test -s target/openqg/research/literature-radar/latest/evidence.json && test -f target/openqg/research/literature-radar/latest/complete.ok)"
        timeout: 10s
        assert:
          exit_code: 0

# ── Unattended parallel operation ─────────────────────────────────────

interaction:
  user: none
  on_blocked: skip_and_next

# ── Permissions (same as original) ────────────────────────────────────

permissions:
  read: allow
  list: allow
  glob: allow
  grep: allow
  shell: allow
  edit: allow
  research: allow
  websearch: allow
  webfetch: allow
  git_commit: deny
  git_push: deny

# ── Fleet: 4 agent workers (independently controllable) ──────────────

fleet:
  max_workers: 4
  isolation: same_session
  jnoccio:
    enabled: true
    base_url: "http://127.0.0.1:4317"
    metrics_ws: "/v1/jnoccio/metrics/ws"
    register_workers: true
    heartbeat_path: "/v1/jnoccio/agents/heartbeat"
    heartbeat_interval: 30s
    max_instances: 4
  telemetry:
    publish_to: jnoccio
    headers:
      x-jekko-run-id: "${run.id}"
      x-jekko-session: "${session.id}"

# ── Research: 5 search threads per worker (independently controllable) ─

research:
  version: v1
  mode: mixed
  autonomy: require_plan
  max_parallel: 5
  timeout_seconds: 45
  provider_policy:
    prefer: [official_api, primary_source, privacy_first]
    allow: [openalex, crossref, arxiv, pubmed, semantic_scholar, unpaywall, gdelt, exa, brave, tavily, searxng, firecrawl, jina, github]
    missing_provider: skip_with_receipt
  extraction:
    enabled: true
    max_pages: 10
    allowed_extractors: [built_in, jina, firecrawl]
  evidence:
    require_citations: true
    claim_level: true
    store: sqlite
  safety:
    redact_secrets: true
    block_internal_urls: true
    prompt_injection: quarantine
    taint_label: web_content
  budgets:
    max_queries: 48
    max_pages: 40
    max_cost_usd: 4.0

# ── Coordinated Domain Sharding ───────────────────────────────────────
#
# Each experiment lane maps to one fleet worker and one domain shard.
# Workers only search their assigned topic space, preventing parallel waste.
# The reduce phase deduplicates and synthesizes across all shards.

experiments:
  strategy: parallel_distill_refine
  max_parallel: 4
  lanes:
    - id: qg-core
      hypothesis: Recent loop quantum gravity, causal dynamical triangulations, spin foam, and asymptotic safety papers contain new primary-source evidence
      agent: plan
      isolation: same_session
      budget:
        max_iterations: 8
        max_cost_usd: 1.0
    - id: cosmology-obs
      hypothesis: Recent CMB, BAO, gravitational wave, and dark energy observational papers provide new constraints on quantum gravity
      agent: plan
      isolation: same_session
      budget:
        max_iterations: 8
        max_cost_usd: 1.0
    - id: math-formal
      hypothesis: Recent causal set, non-commutative geometry, twistor, and category-theoretic quantum gravity papers advance formal frameworks
      agent: plan
      isolation: same_session
      budget:
        max_iterations: 8
        max_cost_usd: 1.0
    - id: phenomenology
      hypothesis: Recent collider, Planck-scale, neutrino mass, and dark matter phenomenology papers provide testable quantum gravity predictions
      agent: plan
      isolation: same_session
      budget:
        max_iterations: 8
        max_cost_usd: 1.0
  reduce:
    strategy: synthesize_best
    require_final_verification: true
  on_partial_failure: pause
  preserve_failed_lanes_as_negative_memory: true

# ── Memory: coordination store for cross-worker deduplication ─────────

memory:
  stores:
    literature_receipts:
      scope: run
      retention: session
      write_policy: append_only
      read_policy: on_demand
      searchable: true
    search_coordination:
      scope: run
      retention: session
      write_policy: upsert
      read_policy: search
      searchable: true
  provenance:
    track_source: true
    hash_chain: true

# ── Evidence ──────────────────────────────────────────────────────────

evidence:
  require_before_promote:
    - type: citation
      must_exist: true
    - type: provider_receipt
      must_exist: true
  bundle_format: json
  sign: sha256
  archive: true

# ── UI ────────────────────────────────────────────────────────────────

ui:
  theme: jekko-gold
  banner: OpenQG literature radar (20-thread)
<<<END_ZYAL id=openqg-literature-radar-20thread>>>
ZYAL_ARM RUN_FOREVER id=openqg-literature-radar-20thread
