<<<ZYAL v1:daemon id=openqg-theory-incubator>>>
version: v1
intent: daemon
confirm: RUN_FOREVER

job:
  name: openqg-theory-incubator
  objective: Strengthen candidate theory manifests until they are benchmarkable and interpretable.

loop:
  policy: forever
  sleep: 45m

stop:
  all:
    - shell:
        command: "test -f .halt-theory-incubator || (test -s target/openqg/theory-incubator/latest/evidence.json && test -f target/openqg/theory-incubator/latest/complete.ok)"
        timeout: 10s
        assert:
          exit_code: 0

checkpoint:
  when: after_verified_change

permissions:
  git_push: deny

ui:
  theme: jekko-gold
  banner: OpenQG theory incubator
<<<END_ZYAL id=openqg-theory-incubator>>>
ZYAL_ARM RUN_FOREVER id=openqg-theory-incubator
