<<<ZYAL v1:daemon id=zyal-genome-jailgun-only>>>
version: v1
intent: daemon
confirm: RUN_FOREVER

imports:
  - run-template.zyal

job:
  name: zyal-genome-jailgun-only
  objective: Execute the jailgun-only routing track for the theory-gene loop.
  risk: high

loop:
  policy: forever
  sleep: 30m

context:
  repository_root: .
  stage_root: ZYAL/stages
  run_root: target/openqg/zyal-genome

workflow:
  stage_sequence:
    - 00-atlas
    - 01-decompose-known
    - 02-decompose-failed
    - 03-generate-genes
    - 04-repair-genes
    - 05-compatibility
    - 06-assemble-modules
    - 07-macro-test
    - 08-failure-slicing
    - 09-selection-mutation
    - 10-promotion

evaluation:
  schema_version: zyal-gene-eval.v1
  variant: jailgun-only
  output_root: target/openqg/zyal-genome/jailgun-only
  max_generations_default: 1
  score_blend:
    local_score: 0.30
    interface_score: 0.20
    macro_score: 0.30
    innovation_score: 0.15
    failure_penalty: 0.05
  routing:
    all_backend: jailgun
    hard_route_tier: manual
    standard_route_tier: manual
    router_state: nominal
    strict_timeouts: true
    retry_limit: 2
  judge:
    family: jailgun
    provenance: backend-wrapper
    route_tier: manual
    token_budget:
      prompt: 6144
      completion: 3072
  evidence:
    run_events: run-events.jsonl
    stage_ledger: stage-ledger.jsonl
    run_summary: run-summary.json
    offline_eval: offline-eval.json
    comparison: comparison.json

budgets:
  max_generations: 1000
  max_runtime_minutes: 360

models:
  primary: jailgun
  fallback: jailgun

experiments:
  route_policy: jailgun_only
  hard_stage_families:
    - hard
  soft_stage_families:
    - standard

stop:
  all:
    - shell:
        command: "test -f .halt-zyal-genome-jailgun-only || test -s target/openqg/zyal-genome/jailgun-only/latest/run-summary.json"
        timeout: 10s
        assert:
          exit_code: 0

checkpoint:
  when: after_verified_change

permissions:
  git_push: deny

ui:
  theme: jekko-gold
  banner: OpenQG ZYAL genome jailgun only
<<<END_ZYAL id=zyal-genome-jailgun-only>>>
ZYAL_ARM RUN_FOREVER id=zyal-genome-jailgun-only
