<<<ZYAL v1:daemon id=openqg-paper-hard-question-fanout>>>
version: v1
intent: daemon
confirm: RUN_FOREVER
job:
  name: openqg-paper-hard-question-fanout
  objective: Generate, answer, criticize, and audit hard answerable questions from existing OA paper records.
loop:
  policy: once
stop:
  all:
    - shell:
        command: "test -s target/openqg/research/openqg-paper-hard-question-fanout/latest/evidence.json && test -f target/openqg/research/openqg-paper-hard-question-fanout/latest/complete.ok"
        timeout: 10s
        assert:
          exit_code: 0
permissions:
  read: allow
  list: allow
  shell: allow
  edit: allow
  research: allow
  git_commit: deny
  git_push: deny
research:
  version: v1
  mode: academic
  autonomy: fixed_sources
  max_parallel: 10
  timeout_seconds: 90
experiments:
  strategy: parallel_distill_refine
  max_parallel: 10
  lanes:
    - id: generator-a
      hypothesis: Generate hard answerable paper questions.
    - id: generator-b
      hypothesis: Generate alternate hard answerable paper questions.
    - id: answerer-a
      hypothesis: Blind-answer candidate questions from context.
    - id: critic-a
      hypothesis: Criticize support and ambiguity.
  reduce:
    strategy: synthesize_best
ui:
  theme: jekko-gold
  banner: OpenQG hard paper question fanout
<<<END_ZYAL id=openqg-paper-hard-question-fanout>>>
ZYAL_ARM RUN_FOREVER id=openqg-paper-hard-question-fanout
