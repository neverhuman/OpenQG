<<<ZYAL v1:daemon id=openqg-paper-qbank-endtoend-smoke>>>
version: v1
intent: daemon
confirm: RUN_FOREVER
job:
  name: openqg-paper-qbank-endtoend-smoke
  objective: Run a small OA paper question-bank smoke loop with one paper, two generators, two answerers, one critic, and one auditor.
loop:
  policy: once
stop:
  all:
    - shell:
        command: "test -s target/openqg/research/openqg-paper-qbank-endtoend-smoke/latest/evidence.json && test -f target/openqg/research/openqg-paper-qbank-endtoend-smoke/latest/complete.ok"
        timeout: 10s
        assert:
          exit_code: 0
permissions:
  read: allow
  list: allow
  shell: allow
  edit: allow
  research: allow
research:
  version: v1
  mode: academic
  autonomy: require_plan
  max_parallel: 2
  paper_scan:
    enabled: true
    domains: [physics]
    open_access: required
    max_papers: 1
  full_text:
    enabled: true
    store: checked_in_json
    license_policy: oa_only
  context_packing:
    strategy: hard
    target_fill_ratio: 0.82
    output_reserve_tokens: 4096
  question_bank:
    output_root: research/knowledge/question-bank
    acceptance:
      min_auditor_agreement: 0.75
      min_answerability: 0.90
      max_blind_correct_rate_for_hard: 0.50
      reject_if_ambiguous: true
  agent_trials:
    question_generators: 2
    answerers: 2
  audit:
    critics: 1
    focused_auditors: 1
experiments:
  strategy: parallel_distill_refine
  max_parallel: 2
  lanes:
    - id: smoke-generator
      hypothesis: Generate a smoke hard question from one OA paper.
    - id: smoke-auditor
      hypothesis: Audit the smoke question and route metadata.
  reduce:
    strategy: synthesize_best
ui:
  theme: jekko-gold
  banner: OpenQG paper question bank smoke
<<<END_ZYAL id=openqg-paper-qbank-endtoend-smoke>>>
ZYAL_ARM RUN_FOREVER id=openqg-paper-qbank-endtoend-smoke
