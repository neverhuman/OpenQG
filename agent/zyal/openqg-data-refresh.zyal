<<<ZYAL v1:daemon id=openqg-data-refresh>>>
version: v1
intent: daemon
confirm: RUN_FOREVER

job:
  name: openqg-data-refresh
  objective: Refresh dataset manifests and regenerate the lockfile through the declared command.

loop:
  policy: forever
  sleep: 12h

stop:
  all:
    - shell:
        command: "test -f .halt-data-refresh || (test -s target/openqg/data/locks/data-lock.json && test -f target/openqg/data/refresh/latest/complete.ok)"
        timeout: 10s
        assert:
          exit_code: 0

checkpoint:
  when: after_verified_change

permissions:
  git_push: deny

ui:
  theme: jekko-gold
  banner: OpenQG data refresh
<<<END_ZYAL id=openqg-data-refresh>>>
ZYAL_ARM RUN_FOREVER id=openqg-data-refresh
